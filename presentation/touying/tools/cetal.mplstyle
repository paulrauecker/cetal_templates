# cetal.mplstyle -- figure defaults from the CETAL Style Guide (draft, 2026-10-14)
# Use:  plt.style.use("cetal.mplstyle")
# Sizes are for a single journal column; override figure.figsize for double column (7.0, 3.2)
# or slides (5.5, 3.6 at font.size 14).

figure.figsize     : 3.4, 2.6
figure.dpi         : 150
figure.constrained_layout.use : True
savefig.dpi        : 600
savefig.bbox       : tight
savefig.pad_inches : 0.02

font.family        : sans-serif
font.sans-serif    : IBM Plex Sans, Source Sans 3, TeX Gyre Heros, DejaVu Sans
# Maths as on the slides: upright in IBM Plex Math, variables in IBM Plex Serif Italic (Plex Math
# has no separate italic font for mathtext to use). Missing glyphs come from STIX. No LaTeX needed.
mathtext.fontset   : custom
mathtext.rm        : IBM Plex Math
mathtext.it        : IBM Plex Serif:italic
mathtext.bf        : IBM Plex Serif:bold
mathtext.sf        : IBM Plex Sans
mathtext.fallback  : stix
font.size          : 8
axes.labelsize     : 8
axes.titlesize     : 8
xtick.labelsize    : 7
ytick.labelsize    : 7
legend.fontsize    : 7
legend.frameon     : False

# Brand neutrals for everything that is not data; Okabe-Ito for the data.
# <tokens> generated from assets/tokens.toml by tools/sync_tokens.py; edit there
text.color         : 1A1A1A
axes.edgecolor     : 1A1A1A
axes.labelcolor    : 1A1A1A
xtick.color        : 1A1A1A
ytick.color        : 1A1A1A
legend.labelcolor  : 1A1A1A
grid.color         : D0D0D0
axes.prop_cycle    : cycler('color', ['0072B2', 'D55E00', '009E73', 'E69F00', 'CC79A7', '56B4E9', 'F0E442', '1A1A1A'])
# </tokens>
grid.linewidth     : 0.4

axes.linewidth     : 0.6
lines.linewidth    : 1.0
lines.markersize   : 3
errorbar.capsize   : 1.5

xtick.direction    : in
ytick.direction    : in
xtick.top          : True
ytick.right        : True
xtick.major.width  : 0.6
ytick.major.width  : 0.6
xtick.minor.visible: True
ytick.minor.visible: True

image.cmap         : viridis
pdf.fonttype       : 42
ps.fonttype        : 42
